{
  "type": "web_service",
  "name": "smart-price-tracker",
  "ownerId": "tea-d47khgje5dus73b1iiv0",
  "repo": "https://github.com/Koushik1708/smart-price-tracker",
  "branch": "main",
  "rootDir": ".",
  "autoDeploy": "yes",
  "serviceDetails": {
    "env": "python",
    "plan": "free",
    "envSpecificDetails": { "buildCommand": "pip install -r requirements.txt && playwright install chromium",
    "startCommand": "uvicorn backend.main:app --host 0.0.0.0 --port $PORT" },
    "envVars": [
      {
        "key": "DATABASE_URL",
        "value": "postgresql://user:password@hostname/database"
      },
      {
        "key": "ALLOWED_ORIGINS",
        "value": "https://frontend-kappa-olive-25.vercel.app"
      },
      {
        "key": "FRONTEND_URL",
        "value": "https://frontend-kappa-olive-25.vercel.app"
      },
      {
        "key": "APP_VERSION",
        "value": "1.0.0"
      },
      {
        "key": "ENVIRONMENT",
        "value": "production"
      },
      {
        "key": "TWILIO_ACCOUNT_SID",
        "value": "YOUR_TWILIO_ACCOUNT_SID"
      },
      {
        "key": "TWILIO_AUTH_TOKEN",
        "value": "YOUR_TWILIO_AUTH_TOKEN"
      },
      {
        "key": "TWILIO_WHATSAPP_NUMBER",
        "value": "whatsapp:+14155238886"
      }
    ]
  }
}
